{
  "manifest_version": 3,
  "name": "Hyday Capture",
  "version": "0.1.6",
  "description": "一鍵把當前網頁擷取成 Hyday 能吃的 Markdown 筆記，落進你本機的 vault",
  "icons": {
    "16": "hyday-capture-icon-16.png",
    "32": "hyday-capture-icon-32.png",
    "48": "hyday-capture-icon-48.png",
    "128": "hyday-capture-icon-128.png"
  },
  "action": {
    "default_title": "擷取到 Hyday",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "hyday-capture-icon-16.png",
      "32": "hyday-capture-icon-32.png",
      "48": "hyday-capture-icon-48.png",
      "128": "hyday-capture-icon-128.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/extract/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "擷取當前頁面到 Hyday"
    }
  },
  "homepage_url": "https://github.com/mukiwu/hyday-capture",
  "permissions": ["storage", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"]
}
