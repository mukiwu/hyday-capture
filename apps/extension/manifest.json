{
  "manifest_version": 3,
  "name": "hyday-capture",
  "version": "0.1.0",
  "description": "一鍵把當前網頁擷取成 hyday 能吃的 Markdown 筆記，落進你本機的 vault",
  "action": {
    "default_title": "擷取到 hyday",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/extract/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "擷取當前頁面到 hyday"
    }
  },
  "permissions": ["tabs", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
