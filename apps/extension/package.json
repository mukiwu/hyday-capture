{
  "name": "@hyday-capture/extension",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "zip": "pnpm build && mkdir -p release && rm -f release/*.zip && cd dist && zip -rqX \"../release/hyday-capture-v$npm_package_version.zip\" . && echo \"打包完成: release/hyday-capture-v$npm_package_version.zip\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyday-capture/organize-engine": "workspace:*",
    "defuddle": "^0.19.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
